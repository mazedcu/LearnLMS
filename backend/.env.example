DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgres://user:password@localhost:5432/lms_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-password
DEFAULT_FROM_EMAIL=LMS Platform <your@email.com>

# Moodle
MOODLE_BASE_URL=https://campus.rawdatun.org
MOODLE_SERVICE_TOKEN=your-moodle-token-here

# DeepSeek AI
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Storage (set to 'local' for dev, 's3' for prod)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Frontend URL (for CORS + email links)
FRONTEND_URL=http://localhost:5173
